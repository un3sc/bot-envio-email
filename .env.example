# ============================================================
# Edital Alert Bot — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com seus dados:
#   cp .env.example .env
#
# NUNCA faça commit do arquivo .env com dados reais!
# ============================================================

# --- Configurações de E-mail (Gmail) ---
# Endereço de e-mail que enviará os alertas
EMAIL_USER=seu_email@gmail.com

# Senha de App do Gmail (não é a senha normal da conta)
# Como gerar: https://support.google.com/accounts/answer/185833
EMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx

# E-mail(s) que receberão os alertas
# Para múltiplos destinatários, separe por vírgula
EMAIL_TO=destinatario@email.com

# --- Configurações da IA (Google Gemini) ---
# Chave de API do Google AI Studio
# Como obter: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...
